---
import type { AreaId } from '../data/areas';
interface Props { area: AreaId; size?: number; }
const { area, size = 22 } = Astro.props;
---
<svg aria-hidden="true" focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
  {area === 'computer-vision' && (
    <>
      <circle cx="12" cy="12" r="6" />
      <path d="M12 2v5M12 17v5M2 12h5M17 12h5" />
    </>
  )}
  {area === 'security' && (
    <>
      <rect x="5" y="11" width="14" height="10" rx="2" />
      <path d="M8 11V8a4 4 0 0 1 8 0v3" />
    </>
  )}
  {area === 'swe-ai' && (
    <>
      <circle cx="5" cy="18" r="2.5" />
      <circle cx="12" cy="6" r="2.5" />
      <circle cx="19" cy="16" r="2.5" />
      <path d="M6.5 16 10.5 8M13.5 8l4 6M7.5 18h9" />
    </>
  )}
</svg>
