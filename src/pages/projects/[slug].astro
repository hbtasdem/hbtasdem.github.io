---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AreaTag from '../../components/AreaTag.astro';
import { getProjects, type Project } from '../../lib/projects';
import { areaById } from '../../data/areas';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((p) => p.data.caseStudy)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const d = project.data;
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
const area = areaById[d.area];

const facts = [
  d.timeline && { k: 'Timeline', v: d.timeline },
  d.team && { k: 'Team', v: d.team },
  d.role && { k: 'Role', v: d.role },
  d.shipped && { k: 'Shipped', v: d.shipped },
].filter(Boolean) as { k: string; v: string }[];
---
<Base title={d.title} description={d.summary} area={d.area}>
  <article data-area={d.area}>
    <header class="wrap head">
      <a class="text-link back mono" href={`/${d.area}/`}>← {area.name}</a>
      <AreaTag area={d.area} also={d.tags} extra={d.kind} />
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <dl class="facts">
        {facts.map((f) => (
          <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
        ))}
        {d.contributions.length > 0 && (
          <div class="wide"><dt>My contributions</dt><dd>{d.contributions.join(' · ')}</dd></div>
        )}
        {d.stack.length > 0 && (
          <div class="wide"><dt>Stack</dt><dd class="mono">{d.stack.join(' · ')}</dd></div>
        )}
      </dl>
      {d.links.length > 0 && (
        <p class="links">
          {d.links.map((l) => <a class="btn" href={l.href}>{l.label}</a>)}
        </p>
      )}
    </header>

    <div class="wrap body">
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <ol>
            {toc.map((h, i) => (
              <li><a href={`#${h.slug}`}><span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span> {h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .head { padding-block: var(--space-xl) var(--space-l); }
  .back { font-size: var(--step--1); margin-bottom: var(--space-s); }
  h1 { margin-top: 0.75rem; font-size: var(--step-5); }
  .lede { margin-top: var(--space-s); max-width: 46rem; font-size: var(--step-1); line-height: 1.5; }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-s) var(--space-m);
    margin: var(--space-l) 0 0;
    padding-block: var(--space-m);
    border-block: 1px solid var(--line);
  }
  .facts .wide { grid-column: 1 / -1; }
  .facts dt { font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .facts dd { margin: 0.25rem 0 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-m); }

  .body {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    align-items: flex-start;
    padding-bottom: var(--space-2xl);
  }
  .toc { flex: 1 1 13rem; position: sticky; top: var(--space-m); }
  .toc ol { list-style: none; margin: 0; padding: 0 0 0 1rem; border-left: 2px solid var(--line); }
  .toc a { display: flex; gap: 0.5rem; padding: 0.4rem 0; min-height: 44px; align-items: center; text-decoration: none; font-size: 0.9375rem; }
  .toc a:hover { text-decoration: underline; }
  .toc .mono { color: var(--accent); }
  @media (max-width: 60rem) { .toc { position: static; } }

  .prose { flex: 999 1 36rem; min-width: 0; max-width: 46rem; }
  .prose :global(h2) { margin-top: var(--space-2xl); scroll-margin-top: var(--space-m); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin-top: var(--space-l); font-family: var(--font-body); font-size: var(--step-1); font-weight: 600; letter-spacing: 0; line-height: 1.3; }
  .prose :global(h2 + p), .prose :global(h3 + p), .prose :global(h2 + ul), .prose :global(h3 + ul), .prose :global(h3 + ol) { margin-top: 0.75rem; }
  .prose :global(p + p) { margin-top: var(--space-s); }
  .prose :global(p + ul), .prose :global(p + ol), .prose :global(ul + p) { margin-top: var(--space-s); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; }
  .prose :global(li + li) { margin-top: 0.4rem; }
  .prose :global(code) { padding: 0.1em 0.35em; border-radius: 4px; background: var(--surface); border: 1px solid var(--line); }

  /* Images, side by side when two share a paragraph. */
  .prose :global(p:has(> img)) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-m);
    margin-top: var(--space-m);
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .prose :global(p:has(> img + img) img) { flex: 0 1 15rem; width: 15rem; }
  .prose :global(p:has(> img) + p > em:only-child) { display: block; }
  .prose :global(p:has(> img) + p) { margin-top: 0.75rem; font-size: 0.9375rem; color: var(--muted); }
  .prose :global(em) { font-style: normal; }

  /* Flow diagrams */
  .prose :global(.flow) { margin: var(--space-m) 0 0; padding: var(--space-m); border: 1px solid var(--line); border-radius: var(--radius); }
  .prose :global(.flow ol) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .prose :global(.flow li) { position: relative; margin: 0; padding: 0.6rem 0.8rem; border: 1.5px solid var(--ink); border-radius: var(--radius-s); background: var(--bg); }
  .prose :global(.flow li:not(:last-child)::after) { content: '→'; position: absolute; right: -1.35rem; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .prose :global(.flow li.key) { border-color: var(--accent); color: var(--accent); }
  .prose :global(.flow figcaption) { margin-top: var(--space-s); font-size: 0.9375rem; color: var(--muted); }

  /* Before / after */
  .prose :global(.compare) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--space-s); margin-top: var(--space-m); }
  .prose :global(.compare figure) { margin: 0; padding: var(--space-s); border: 1px solid var(--line); border-radius: var(--radius); }
  .prose :global(.compare figcaption) { font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 0.5rem; }

  /* Tables */
  .prose :global(.table-scroll) { margin-top: var(--space-m); overflow-x: auto; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9375rem; font-variant-numeric: tabular-nums; }
  .prose :global(caption) { text-align: left; padding-bottom: 0.5rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.55rem 0.75rem 0.55rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(thead th) { border-bottom: 2px solid var(--ink); }
  .prose :global(.matrix td) { text-align: center; padding-inline: 0.4rem; min-width: 2.5rem; }
  .prose :global(.matrix thead th:not(:first-child)) { text-align: center; padding-inline: 0.4rem; }
  .prose :global(.matrix td.hit) { font-weight: 600; background: color-mix(in srgb, var(--accent) 14%, transparent); }

  /* Threat model */
  .prose :global(.threat) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--space-m); margin: var(--space-m) 0 0; }
  .prose :global(.threat div) { border-top: 2px solid var(--ink); padding-top: 0.75rem; }
  .prose :global(.threat dt) { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); }
  .prose :global(.threat dd) { margin: 0.4rem 0 0; }
</style>
