---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap inner">
    <div>
      <p class="cta">Let’s build something.</p>
      <a class="email" href="mailto:hilalbtasdemir@gmail.com">hilalbtasdemir@gmail.com</a>
    </div>
    <ul class="links">
      <li><a href="https://github.com/hbtasdem">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/hilalbtasdemir">LinkedIn</a></li>
      <li><a href="/resume.pdf">Resume (PDF)</a></li>
    </ul>
  </div>
  <p class="wrap fine">© {year} Hilal Beyza Tasdemir</p>
</footer>

<style>
  .site-footer {
    --focus: var(--bg);
    background: var(--ink);
    color: var(--bg);
    padding-block: var(--space-xl) var(--space-m);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
  }
  .cta {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.1;
  }
  .email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    margin-top: 0.25rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a { display: inline-flex; align-items: center; min-height: 44px; }
  .fine { margin-top: var(--space-l); font-size: var(--step--1); opacity: 0.85; }
</style>
