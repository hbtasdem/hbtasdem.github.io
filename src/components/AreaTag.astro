---
import AreaIcon from './AreaIcon.astro';
import { areaById, type AreaId } from '../data/areas';
interface Props { area: AreaId; also?: AreaId[]; extra?: string; }
const { area, also = [], extra } = Astro.props;
const alsoText = also.map((a) => areaById[a].label).join(', ');
---
<p class="area-tag" data-area={area}>
  <AreaIcon area={area} size={16} />
  <span>{areaById[area].label}{alsoText && ` · also ${alsoText}`}{extra && ` · ${extra}`}</span>
</p>

<style>
  .area-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .area-tag :global(svg) { flex: none; }
</style>
