---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap section">
    <p class="eyebrow mono">Error 404</p>
    <h1>Nothing here.</h1>
    <p class="lede">That page doesn’t exist, or it moved.</p>
    <p class="actions"><a class="btn btn--solid" href="/">Go to the home page</a></p>
  </section>
</Base>

<style>
  h1 { margin-top: var(--space-s); }
  .lede { margin-top: var(--space-s); font-size: var(--step-1); }
  .actions { margin-top: var(--space-l); }
</style>
